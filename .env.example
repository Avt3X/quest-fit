# ---------------------------------------------------------------------------------------------
# QuestFit environment. Copy to `.env.local` (gitignored) and fill in.
# Only EXPO_PUBLIC_* values are bundled into the app. Never put secrets in EXPO_PUBLIC_* values.
# ---------------------------------------------------------------------------------------------

# Supabase project URL and anon (publishable) key: Dashboard > Project Settings > API.
# Local development: run `npm run db:start`; it prints these values (API_URL and ANON_KEY).
# On a physical phone use your computer's LAN IP instead of 127.0.0.1.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Social sign-in. Only set to true after configuring the provider in Supabase Auth
# (Dashboard > Authentication > Providers). See docs/SETUP.md.
EXPO_PUBLIC_AUTH_GOOGLE_ENABLED=false
EXPO_PUBLIC_AUTH_APPLE_ENABLED=false

# Native build configuration (read by app.config.ts, not bundled into JS).
# Android map tiles need a Google Maps SDK for Android key in release builds.
GOOGLE_MAPS_ANDROID_API_KEY=
# EAS project id, required for push notification tokens (`npx eas-cli init`).
EAS_PROJECT_ID=
# Optional bundle identifiers.
IOS_BUNDLE_IDENTIFIER=com.questfit.app
ANDROID_PACKAGE=com.questfit.app

# ---------------------------------------------------------------------------------------------
# Server-side only (Edge Functions / CI). NEVER expose these to the app.
# ---------------------------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=   # set with `supabase secrets set`, never in this file for the app
# EXPO_ACCESS_TOKEN=           # optional, for the push-dispatch Edge Function
# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres  # integration tests
